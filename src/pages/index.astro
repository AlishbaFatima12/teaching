---
import Base from '../layouts/Base.astro';
import Tex from '../components/Tex.astro';
import SectionHead from '../components/SectionHead.astro';
import HeroCurve from '../components/islands/HeroCurve';
import ModuleCard from '../components/ModuleCard.astro';
import { person, education, roles, aiFinding } from '../content/facts';
import { modules } from '../content/modules';
import { siteConfig } from '../site.config';
import { url, availableDocs } from '../lib/site';

const docs = availableDocs();
const msc = education[0];
const fpsc = roles.find((r) => r.id === 'F4')!;
const yt = siteConfig.youtubeId.trim();
---
<Base current="">
  <!-- ========== HERO ========== -->
  <section class="graph-paper relative overflow-hidden border-b border-rule" aria-labelledby="hero-title">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-paper"></div>
    <div class="container-x relative grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-[1.05fr_1fr] lg:gap-14 lg:py-24">
      <div>
        <p class="kicker">Teaching portfolio</p>
        <h1 id="hero-title" class="mt-5 text-[2.75rem] font-normal leading-[1.02] text-ink sm:text-[3.6rem] lg:text-[4.1rem]">
          {person.name}
        </h1>
        <p class="sr-only">{person.roleLine}</p>
        <div class="mt-5" aria-hidden="true">
          <p class="hero-rise font-serif text-[1.45rem] italic leading-none text-accent sm:text-[1.7rem]">{person.roleTitle}</p>
          <ul class="mt-4 flex flex-wrap gap-2.5">
            {person.subjects.map((s, i) => (
              <li class="hero-rise flex items-center gap-2.5 rounded-full border border-rule-strong bg-surface/80 py-1.5 pl-1.5 pr-4 shadow-card backdrop-blur" style={`animation-delay:${180 + i * 110}ms`}>
                <span class="grid h-8 w-8 place-items-center rounded-full bg-accent font-serif text-lg italic leading-none text-accent-ink">{s.glyph}</span>
                <span class="font-medium tracking-wide text-ink">{s.name}</span>
              </li>
            ))}
          </ul>
        </div>
        <p class="mt-7 max-w-xl border-l-2 border-accent pl-5 font-serif text-[1.35rem] leading-snug text-ink sm:text-[1.55rem]">
          I teach mathematics so that students can see <em>why</em> it works, compute it with confidence,
          and check every answer, including the ones an AI gives them.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={url('lab/')}>
            Open the Interactive Lab
            <svg aria-hidden="true" viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
          <a class="btn btn-ghost" href={url('ai-lab/')}>AI Verification Lab</a>
          {docs.map((d) => (
            <a class="btn btn-ghost" href={url(`docs/${d.file}`)} download>
              <svg aria-hidden="true" viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 2v8M4.5 7 8 10.5 11.5 7M3 13.5h10"/></svg>
              {d.label} <span class="sr-only">(PDF)</span>
            </a>
          ))}
        </div>
      </div>

      <div class="reveal">
        <HeroCurve client:idle />
        <div class="mt-4 flex items-center justify-between gap-4 px-1 text-sm text-ink-3">
          <Tex tex={String.raw`\displaystyle f'(a)=\lim_{h\to 0}\frac{f(a+h)-f(a)}{h}`} class="text-ink-2" />
          <a class="link shrink-0" href={url('lab/secant-tangent/')}>Module A →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PROOF POINTS ========== -->
  <section aria-labelledby="proof-title" class="relative">
    <h2 id="proof-title" class="sr-only">Three proof points</h2>
    <div class="container-x -mt-px grid gap-4 py-12 md:grid-cols-3 md:gap-5">
      <article class="card reveal flex flex-col p-6 sm:p-7">
        <p class="kicker">Scholarship</p>
        <p class="num mt-4 text-[2.6rem] font-medium leading-none tracking-tight text-ink"><span data-count="91.4" data-decimals="1">{msc.result.replace('%', '')}</span><span class="text-ink-3">%</span></p>
        <h3 class="mt-4 text-xl text-ink">Gold Medal, {msc.degree}</h3>
        <p class="mt-2 text-[0.95rem] text-ink-2">{msc.honour.replace('Gold Medal: ', '')}, {msc.institution} ({msc.year}).</p>
      </article>

      <article class="card reveal flex flex-col p-6 sm:p-7" style="transition-delay:80ms">
        <p class="kicker">Public-service selection</p>
        <p class="mt-4 font-serif text-[2.6rem] leading-none tracking-tight text-ink">FPSC</p>
        <h3 class="mt-4 text-xl text-ink">{fpsc.title}</h3>
        <p class="mt-2 text-[0.95rem] text-ink-2">
          Appointed on the recommendation of Pakistan's Federal Public Service Commission; taught FSc Pre-Engineering
          mathematics (Grades 11–12), {fpsc.dates.replace(' – ', '–')}.
        </p>
      </article>

      <article class="card reveal flex flex-col p-6 sm:p-7" style="transition-delay:160ms">
        <p class="kicker">Evidence on AI in learning</p>
        <p class="num mt-4 flex items-baseline gap-3 text-[2.6rem] font-medium leading-none tracking-tight">
          <span class="text-ink-3 line-through decoration-2 decoration-ink-3/60"><span data-count={aiFinding.aggregate}>{aiFinding.aggregate}</span>%</span>
          <span aria-hidden="true" class="text-2xl text-ink-3">→</span>
          <span class="text-accent"><span data-count={aiFinding.truePass}>{aiFinding.truePass}</span>%</span>
        </p>
        <h3 class="mt-4 text-xl text-ink">What an average concealed</h3>
        <p class="mt-2 text-[0.95rem] text-ink-2">
          I evaluated {aiFinding.tool}, an LLM tutoring agent I built: an {aiFinding.aggregate}% aggregate score concealed a {aiFinding.truePass}% true pass
          rate on the hardest cases.
        </p>
        <a class="link mt-auto pt-4 text-sm" href={url('ai-lab/#finding')}>How this shapes my teaching →</a>
      </article>
    </div>
  </section>

  <!-- ========== 60 SECONDS ========== -->
  <section class="py-16 sm:py-20" aria-labelledby="s1">
    <div class="container-x">
      <SectionHead n="01" kicker="In sixty seconds" id="s1" title="Three things a hiring committee should know." />
      <ol class="grid gap-px overflow-hidden rounded-2xl border border-rule bg-rule md:grid-cols-3">
        <li class="reveal bg-surface p-6 sm:p-8">
          <p class="font-serif text-5xl text-accent">1</p>
          <h3 class="mt-4 text-2xl text-ink">I can teach calculus, analysis and algebra well.</h3>
          <p class="mt-3 text-ink-2">
            Precalculus, differential and integral calculus, analytic geometry, matrices and vectors for large FSc
            Pre-Engineering classes; Cambridge O Level and AKU-EB mathematics before that.
          </p>
          <a class="link mt-5 inline-block text-sm" href={url('experience/')}>See the experience timeline →</a>
        </li>
        <li class="reveal bg-surface p-6 sm:p-8">
          <p class="font-serif text-5xl text-accent">2</p>
          <h3 class="mt-4 text-2xl text-ink">I use computation thoughtfully.</h3>
          <p class="mt-3 text-ink-2">
            MATLAB laboratory sessions for undergraduate Numerical Analysis, Python for adult learners at PIAIC, and an
            MS in Computer Science &amp; IT. Six interactive modules on this site show how I'd use it in class.
          </p>
          <a class="link mt-5 inline-block text-sm" href={url('lab/')}>Try the Interactive Lab →</a>
        </li>
        <li class="reveal bg-surface p-6 sm:p-8">
          <p class="font-serif text-5xl text-accent">3</p>
          <h3 class="mt-4 text-2xl text-ink">My view of AI in learning is based on evidence.</h3>
          <p class="mt-3 text-ink-2">
            I measured where an AI tutor fails rather than trusting its average. Students learn the same habit here:
            spot the AI's mistake, then show how you would have caught it.
          </p>
          <a class="link mt-5 inline-block text-sm" href={url('ai-lab/')}>Spot the AI's mistake →</a>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== LAB PREVIEW ========== -->
  <section class="border-y border-rule bg-sunken/50 py-16 sm:py-20" aria-labelledby="s2">
    <div class="container-x">
      <SectionHead n="02" kicker="Interactive Lab" id="s2" title="Six modules, built for a 50-minute class."
        lede="Each module pairs one interactive with learning outcomes, the matching SFU course, three guided questions and teacher notes." />
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {modules.map((m, i) => <li><ModuleCard m={m} delay={(i % 3) * 70} /></li>)}
      </ul>
    </div>
  </section>

  <!-- ========== AI LAB TEASER ========== -->
  <section class="py-16 sm:py-20" aria-labelledby="s3">
    <div class="container-x grid items-center gap-10 lg:grid-cols-2">
      <SectionHead n="03" kicker="AI Verification Lab" id="s3" title="The answer looks right. Is it?"
        lede="Students will use AI. My job is to make sure they can check it. Each item shows a plausible AI answer, a hint, and the worked correction with a one-line check that would have caught the mistake.">
        <a class="btn btn-primary mt-7" href={url('ai-lab/')}>Open the AI Verification Lab</a>
      </SectionHead>

      <figure class="card reveal m-0 p-6 sm:p-7">
        <figcaption class="flex items-center justify-between">
          <span class="kicker">Calculus I · Chain rule</span>
          <span class="rounded-full bg-accent-soft px-2.5 py-1 text-xs font-medium text-accent">Warm-up</span>
        </figcaption>
        <p class="mt-5 text-sm text-ink-3">An AI assistant writes:</p>
        <div class="mt-2 rounded-xl border border-dashed border-rule-strong bg-sunken/60 p-4 text-lg">
          <Tex tex={String.raw`\dfrac{d}{dx}\,\sin\!\left(x^2\right) = \cos\!\left(x^2\right)`} display />
        </div>
        <details class="group mt-5">
          <summary class="cursor-pointer list-none text-[0.95rem] font-medium text-accent marker:hidden">
            <span class="group-open:hidden">Reveal the correction</span><span class="hidden group-open:inline">Hide the correction</span>
          </summary>
          <div class="mt-3 space-y-3 text-ink-2">
            <p>The chain rule needs the derivative of the inside function:</p>
            <Tex tex={String.raw`\dfrac{d}{dx}\,\sin\!\left(x^2\right) = \cos\!\left(x^2\right)\cdot 2x`} display />
            <p class="text-sm"><strong class="text-ink">How to catch it:</strong> check a point. At <Tex tex={String.raw`x=0`} /> the graph of <Tex tex={String.raw`\sin(x^2)`} /> is flat, but <Tex tex={String.raw`\cos(0)=1`} /> claims a slope of 1.</p>
          </div>
        </details>
      </figure>
    </div>
  </section>

  {yt && (
    <section class="border-t border-rule py-16 sm:py-20" aria-labelledby="s-demo">
      <div class="container-x">
        <SectionHead n="04" kicker="Teaching demonstration" id="s-demo" title={siteConfig.youtubeTitle} />
        <div class="card reveal overflow-hidden p-0">
          <div class="relative aspect-video">
            <iframe class="absolute inset-0 h-full w-full" src={`https://www.youtube-nocookie.com/embed/${yt}`}
              title={siteConfig.youtubeTitle} loading="lazy" referrerpolicy="strict-origin-when-cross-origin"
              allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen></iframe>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ========== CONTACT CTA ========== -->
  <section class="py-6" aria-labelledby="s-contact">
    <div class="container-x">
      <div class="reveal relative overflow-hidden rounded-3xl bg-ink px-6 py-12 text-paper sm:px-12 sm:py-16">
        <svg class="pointer-events-none absolute -right-10 -top-6 h-64 w-96 opacity-25" viewBox="0 0 100 60" aria-hidden="true">
          <path d="M4 52 C 30 50, 46 30, 60 18 S 86 6, 96 5" fill="none" stroke="var(--paper)" stroke-width="0.8" />
          <path d="M10 50 L92 10" fill="none" stroke="var(--paper)" stroke-width="0.5" stroke-dasharray="1 2" />
        </svg>
        <p class="kicker !text-paper/70">Contact</p>
        <h2 id="s-contact" class="mt-3 max-w-2xl text-[2rem] leading-tight sm:text-[2.6rem]">Happy to talk about teaching mathematics, workshops and AI in the classroom.</h2>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn bg-paper text-ink hover:bg-paper/90" href={`mailto:${person.email}`}>Email me</a>
          <a class="btn border border-paper/30 text-paper hover:border-paper" href={person.linkedin}>LinkedIn</a>
          <a class="btn border border-paper/30 text-paper hover:border-paper" href={person.github}>GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Count-up for proof numbers; skipped under reduced motion (the final value is already in the HTML).
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const els = document.querySelectorAll<HTMLElement>('[data-count]');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        const el = en.target as HTMLElement;
        io.unobserve(el);
        const end = Number(el.dataset.count);
        const dec = Number(el.dataset.decimals ?? 0);
        const t0 = performance.now();
        const step = (now: number) => {
          const p = Math.min(1, (now - t0) / 1100);
          const e = 1 - Math.pow(1 - p, 3);
          el.textContent = (end * e).toFixed(dec);
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    }, { threshold: 0.6 });
    els.forEach((el) => io.observe(el));
  }
</script>
