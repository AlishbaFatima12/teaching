---
import Base from '../layouts/Base.astro';
import Tex from '../components/Tex.astro';
import SectionHead from '../components/SectionHead.astro';
import { mistakes, checklist, COURSES, LEVELS } from '../content/mistakes';
import { aiFinding, person } from '../content/facts';
import { url } from '../lib/site';

const levelClass: Record<string, string> = {
  'Warm-up': 'bg-accent-soft text-accent',
  Core: 'bg-ink/[0.07] text-ink dark:bg-paper/10',
  Stretch: 'bg-ink text-paper',
};
---
<Base title="AI Verification Lab" current="ai-lab/" description="Spot the AI's mistake: 17 plausible but wrong AI answers across foundations, calculus and linear algebra, each with a hint, a worked correction and a check that would have caught it.">
  <section class="graph-paper border-b border-rule">
    <div class="container-x grid gap-10 py-14 sm:py-20 lg:grid-cols-[1.3fr_1fr] lg:items-center">
      <div>
        <p class="kicker">AI Verification Lab</p>
        <h1 class="mt-4 text-[2.6rem] leading-[1.04] text-ink sm:text-[3.6rem]">Spot the AI's mistake.</h1>
        <p class="mt-6 max-w-2xl text-lg text-ink-2">
          Each item is a plausible answer of the kind an AI assistant can give, with one mathematical error.
          Students find the error, write the correction, and name the check that would have caught it.
          The answer is the goal; the check is the skill.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-primary" href="#items">Start with the items</a>
          <a class="btn btn-ghost" href="#checklist">The verification checklist</a>
          <a class="btn btn-ghost" href="#finding">Why I teach this</a>
        </div>
      </div>
      <figure class="card m-0 p-6">
        <figcaption class="kicker">How each item works</figcaption>
        <ol class="mt-4 space-y-3">
          {['Read the AI\'s answer and decide: right or wrong?', 'Stuck? Open the hint.', 'Reveal the worked correction.', 'Learn the one-line check that catches it.'].map((s, i) => (
            <li class="flex gap-3"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-accent-soft text-sm font-medium text-accent">{i + 1}</span><span class="text-ink-2">{s}</span></li>
          ))}
        </ol>
      </figure>
    </div>
  </section>

  <!-- ========== CHECKLIST ========== -->
  <section id="checklist" aria-labelledby="h-check" class="border-b border-rule bg-sunken/40 py-14 sm:py-16">
    <div class="container-x">
      <SectionHead n="01" kicker="What students learn" id="h-check" title="The verification checklist."
        lede="Seven checks that work on any answer, whether it came from a textbook, a classmate or an AI. Each item below names the one that catches its mistake." />
      <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {checklist.map((c, i) => (
          <li class:list={['card reveal p-5', i === 6 && 'sm:col-span-2 lg:col-span-1']}>
            <div class="flex items-center gap-3">
              <span class="grid h-8 w-8 place-items-center rounded-lg bg-accent text-sm font-semibold text-accent-ink">✓</span>
              <h3 class="font-serif text-lg text-ink">{c.k}</h3>
            </div>
            <p class="mt-3 text-[0.93rem] text-ink-2">{c.v}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ========== ITEMS ========== -->
  <section id="items" aria-labelledby="h-items" class="py-14 sm:py-16">
    <div class="container-x">
      <SectionHead n="02" kicker={`${mistakes.length} items`} id="h-items" title="Find the error before you reveal it." />

      <div class="sticky top-16 z-30 -mx-4 mb-8 border-y border-rule bg-paper/95 px-4 py-3 sm:mx-0 sm:rounded-2xl sm:border">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3" id="filters">
          <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter by course">
            <span class="mr-1 text-sm text-ink-3">Course</span>
            <button type="button" class="chip" data-filter="course" data-value="all" aria-pressed="true">All</button>
            {COURSES.map((c) => <button type="button" class="chip" data-filter="course" data-value={c} aria-pressed="false">{c}</button>)}
          </div>
          <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Filter by difficulty">
            <span class="mr-1 text-sm text-ink-3">Level</span>
            <button type="button" class="chip" data-filter="level" data-value="all" aria-pressed="true">All</button>
            {LEVELS.map((l) => <button type="button" class="chip" data-filter="level" data-value={l} aria-pressed="false">{l}</button>)}
          </div>
          <p class="text-sm text-ink-3 lg:ml-auto" aria-live="polite" id="count">Showing {mistakes.length} of {mistakes.length}</p>
        </div>
      </div>

      <ol class="grid gap-5 lg:grid-cols-2" id="item-list">
        {mistakes.map((m, i) => (
          <li class="item cv-auto min-w-0" data-course={m.course} data-level={m.level} id={m.id}>
            <article class="card flex h-full flex-col p-5 sm:p-6" aria-labelledby={`${m.id}-h`}>
              <header class="flex flex-wrap items-center justify-between gap-2">
                <p class="kicker"><b>{String(i + 1).padStart(2, '0')}</b> · {m.course} · {m.topic}</p>
                <span class:list={['rounded-full px-2.5 py-1 text-xs font-medium', levelClass[m.level]]}>{m.level}</span>
              </header>
              <h3 id={`${m.id}-h`} class="mt-4 font-sans text-[1.02rem] font-medium leading-snug text-ink">{m.prompt}</h3>
              {m.promptTex && <div class="mt-2 text-ink"><Tex tex={m.promptTex} display /></div>}

              <div class="mt-4 rounded-xl border border-dashed border-rule-strong bg-sunken/60 p-4">
                <p class="flex items-center gap-2 text-xs font-medium uppercase tracking-[0.12em] text-ink-3">
                  <svg aria-hidden="true" viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2.5" y="4.5" width="11" height="9" rx="2"/><path d="M8 4.5V2M5.5 8.5h.01M10.5 8.5h.01M6 11h4"/></svg>
                  AI assistant's answer
                </p>
                <div class="mt-2 text-ink"><Tex tex={m.ai} display /></div>
                {m.aiNote && <p class="mt-1 text-sm italic text-ink-2">"{m.aiNote}"</p>}
              </div>

              <div class="mt-4 space-y-2">
                <details class="group rounded-lg border border-rule">
                  <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-2.5 text-sm font-medium text-ink-2 [&::-webkit-details-marker]:hidden">
                    Hint <span aria-hidden="true" class="transition-transform group-open:rotate-45">+</span>
                  </summary>
                  <p class="border-t border-rule px-4 py-3 text-[0.95rem] text-ink-2">{m.hint}</p>
                </details>
                <details class="group rounded-lg border border-accent/40 bg-accent-soft/40">
                  <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-2.5 text-sm font-medium text-accent [&::-webkit-details-marker]:hidden">
                    Reveal the correction <span aria-hidden="true" class="transition-transform group-open:rotate-45">+</span>
                  </summary>
                  <div class="space-y-3 border-t border-accent/30 px-4 py-4 text-ink-2">
                    {m.solution.map((s) => s.tex ? <div class="text-ink"><Tex tex={s.tex} display /></div> : <p class="text-[0.95rem]">{s.text}</p>)}
                    <p class="rounded-lg bg-surface p-3 text-[0.95rem]"><strong class="text-ink">How to catch this:</strong> {m.catchIt}</p>
                  </div>
                </details>
              </div>
            </article>
          </li>
        ))}
      </ol>
      <p id="empty" class="hidden py-10 text-center text-ink-2">No items match these filters.</p>
    </div>
  </section>

  <!-- ========== FINDING ========== -->
  <section id="finding" aria-labelledby="h-finding" class="border-t border-rule bg-sunken/40 py-14 sm:py-20">
    <div class="container-x">
      <SectionHead n="03" kicker="Why I teach this" id="h-finding" title="An 80% score that hid a 17% pass rate." />
      <div class="grid gap-8 lg:grid-cols-2 lg:items-start">
        <div class="reveal space-y-5 text-[1.05rem] text-ink-2">
          <p>
            I built <strong class="text-ink">{aiFinding.tool}</strong>, {aiFinding.what}, and evaluated it with {aiFinding.method}.
            The aggregate score was <strong class="text-ink">{aiFinding.aggregate}%</strong>. On the hardest cases, the true pass rate was
            <strong class="text-accent">{aiFinding.truePass}%</strong>.
          </p>
          <p>
            An aggregate score averages easy and hard cases together, so strong results on the easier cases can hide
            failure on the hardest ones, which is where students need help most.
          </p>
          <h3 class="pt-2 font-serif text-2xl text-ink">How it shapes my teaching</h3>
          <ul class="space-y-3">
            {[
              'I teach students to check AI output on the hard cases (boundaries, special values, hypotheses), because that is where it fails.',
              'I read assessment results by question type as well as by total, so a good average cannot hide a topic the class has not learned.',
              'I treat any AI tool I bring into a course as something to evaluate first, on the problems my students will actually ask.',
              'I model the habit in class: when an answer looks right, we still check it.',
            ].map((t) => (
              <li class="flex gap-3"><span aria-hidden="true" class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span><span>{t}</span></li>
            ))}
          </ul>
          <p class="text-sm">Related research notes: <a class="link" href={person.notesRepo}>agent-reliability-notes on GitHub</a>.</p>
        </div>

        <figure class="card reveal m-0 p-6 sm:p-8">
          <figcaption class="kicker">{aiFinding.tool} · same evaluation, two ways to report it</figcaption>
          <div class="mt-8 space-y-7" role="img" aria-label={`Bar chart: aggregate score ${aiFinding.aggregate} percent; true pass rate on the hardest cases ${aiFinding.truePass} percent.`}>
            <div>
              <div class="flex items-baseline justify-between"><span class="text-ink-2">Aggregate score</span><span class="num text-3xl text-ink-3">{aiFinding.aggregate}%</span></div>
              <div class="mt-2 h-4 overflow-hidden rounded-full bg-sunken"><div class="h-full rounded-full bg-ink-3/60" style={`width:${aiFinding.aggregate}%`}></div></div>
            </div>
            <div>
              <div class="flex items-baseline justify-between"><span class="text-ink-2">True pass rate, hardest cases</span><span class="num text-3xl font-semibold text-accent">{aiFinding.truePass}%</span></div>
              <div class="mt-2 h-4 overflow-hidden rounded-full bg-sunken"><div class="h-full rounded-full bg-accent" style={`width:${aiFinding.truePass}%`}></div></div>
            </div>
          </div>
          <p class="mt-8 border-t border-rule pt-4 text-sm text-ink-3">Evaluation design: {aiFinding.method}.</p>
        </figure>
      </div>
    </div>
  </section>
</Base>

<style>
  .chip {
    border: 1px solid var(--rule-strong);
    background: var(--surface);
    color: var(--ink-2);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    font-size: 0.85rem;
    min-height: 2.25rem;
    transition: background-color 150ms, color 150ms, border-color 150ms;
  }
  .chip:hover { border-color: var(--accent); color: var(--accent); }
  .chip[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
</style>

<script>
  const state: Record<string, string> = { course: 'all', level: 'all' };
  const items = Array.from(document.querySelectorAll<HTMLElement>('#item-list .item'));
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  document.querySelectorAll<HTMLButtonElement>('#filters .chip').forEach((b) => {
    b.addEventListener('click', () => {
      const f = b.dataset.filter!;
      state[f] = b.dataset.value!;
      document.querySelectorAll<HTMLButtonElement>(`#filters .chip[data-filter="${f}"]`).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let n = 0;
      items.forEach((it) => {
        const show = (state.course === 'all' || it.dataset.course === state.course) && (state.level === 'all' || it.dataset.level === state.level);
        it.hidden = !show;
        if (show) n++;
      });
      count.textContent = `Showing ${n} of ${items.length}`;
      empty.classList.toggle('hidden', n > 0);
    });
  });
</script>
