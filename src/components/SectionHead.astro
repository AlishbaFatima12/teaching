---
interface Props { n: string; kicker: string; title: string; id: string; lede?: string; align?: 'left' | 'center' }
const { n, kicker, title, id, lede, align = 'left' } = Astro.props;
---
<div class:list={['reveal mb-10 max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  <p class="kicker"><b>{n}</b> · {kicker}</p>
  <h2 id={id} class="mt-3 text-[2rem] leading-[1.08] text-ink sm:text-[2.6rem]">{title}</h2>
  {lede && <p class="mt-4 text-lg text-ink-2">{lede}</p>}
  <slot />
</div>
