---
import type { LabModule } from '../content/modules';
import { url } from '../lib/site';
interface Props { m: LabModule; delay?: number }
const { m, delay = 0 } = Astro.props;
---
<a href={url(`lab/${m.slug}/`)} class="card reveal group flex h-full flex-col p-5 no-underline transition-colors hover:border-accent" style={`transition-delay:${delay}ms`}>
  <div class="flex items-start justify-between gap-3">
    <span class="grid h-9 w-9 place-items-center rounded-full bg-accent-soft font-serif text-lg text-accent">{m.letter}</span>
    <span class="num rounded-full border border-rule px-2.5 py-1 text-[0.72rem] text-ink-2">{m.course}</span>
  </div>
  <svg viewBox="0 0 100 60" class="my-5 h-20 w-full" aria-hidden="true">
    <path d={m.glyph} fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <h3 class="text-xl text-ink group-hover:text-accent">{m.title}</h3>
  <p class="mt-2 text-[0.95rem] text-ink-2">{m.blurb}</p>
  <span class="mt-auto pt-4 text-sm font-medium text-accent">Open module {m.letter} <span aria-hidden="true">→</span></span>
</a>
