---
import '../styles/global.css';
import { siteConfig } from '../site.config';
import { person } from '../content/facts';
import { url, nav } from '../lib/site';
import serifFont from '@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url';
import sansFont from '@fontsource/inter-tight/files/inter-tight-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** current nav href ('' for home) */
  current?: string;
}
const { title, description = siteConfig.description, current = '' } = Astro.props;
const pageTitle = title ? `${title} · ${person.name}` : siteConfig.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('og.png'), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content="#fbfaf6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1016" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Theme: saved choice, else the operating-system preference. No cookies.
      (function () {
        var d = document.documentElement, t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        if (t === 'dark') d.classList.add('dark');
        d.classList.add('js');
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="sticky top-0 z-50 border-b border-rule/70 bg-paper/95">
      <div class="container-x flex h-16 items-center justify-between gap-4">
        <a href={url()} class="group flex items-center gap-2.5 no-underline" aria-label={`${person.name}, home`}>
          <img src={url('favicon.svg')} alt="" width="28" height="28" class="rounded-md" />
          <span class="font-serif text-[1.15rem] leading-none tracking-tight text-ink">
            {person.name}
          </span>
        </a>

        <nav aria-label="Main" class="hidden lg:block">
          <ul class="flex items-center gap-1 text-[0.92rem]">
            {nav.slice(1).map((n) => (
              <li>
                <a
                  href={url(n.href)}
                  aria-current={current === n.href ? 'page' : undefined}
                  class:list={[
                    'rounded-full px-3 py-2 no-underline transition-colors hover:text-accent',
                    current === n.href ? 'bg-accent-soft text-accent font-medium' : 'text-ink-2',
                  ]}
                >{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="flex items-center gap-1.5">
          <button id="theme-toggle" type="button" class="grid h-11 w-11 place-items-center rounded-full text-ink-2 hover:bg-sunken hover:text-ink" aria-label="Switch to dark theme">
            <svg class="theme-icon-sun hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="theme-icon-moon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
          <button id="menu-toggle" type="button" class="grid h-11 w-11 place-items-center rounded-full text-ink-2 hover:bg-sunken lg:hidden" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>
      <nav id="mobile-nav" aria-label="Main (mobile)" class="hidden border-t border-rule bg-paper lg:hidden">
        <ul class="container-x grid gap-1 py-3">
          {nav.map((n) => (
            <li>
              <a href={url(n.href)} aria-current={current === n.href ? 'page' : undefined}
                 class:list={['block rounded-lg px-3 py-3 no-underline', current === n.href ? 'bg-accent-soft text-accent font-medium' : 'text-ink-2']}>{n.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 border-t border-rule bg-sunken/60">
      <div class="container-x grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <p class="font-serif text-2xl text-ink">{person.name}</p>
          <p class="mt-2 max-w-sm text-sm text-ink-2">{person.roleLine}</p>
        </div>
        <nav aria-label="Footer">
          <p class="kicker mb-3">Pages</p>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
            {nav.map((n) => <li><a class="text-ink-2 no-underline hover:text-accent" href={url(n.href)}>{n.label}</a></li>)}
          </ul>
        </nav>
        <div>
          <p class="kicker mb-3">Contact</p>
          <ul class="grid gap-1.5 text-sm">
            <li><a class="text-ink-2 no-underline hover:text-accent break-all" href={`mailto:${person.email}`}>{person.email}</a></li>
            <li><a class="text-ink-2 no-underline hover:text-accent" href={person.linkedin}>LinkedIn</a></li>
            <li><a class="text-ink-2 no-underline hover:text-accent" href={person.github}>GitHub</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-rule">
        <p class="container-x py-6 text-xs leading-relaxed text-ink-3">
          Interactive resources designed by Syeda Alishba Fatima and built with the help of an AI coding assistant; every result was checked for mathematical accuracy.
          <span class="mt-1 block">No cookies, no tracking.</span>
        </p>
      </div>
    </footer>

    <script>
      // Theme toggle
      const root = document.documentElement;
      const btn = document.getElementById('theme-toggle')!;
      const sync = () => {
        const dark = root.classList.contains('dark');
        btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
        btn.querySelector('.theme-icon-sun')!.classList.toggle('hidden', !dark);
        btn.querySelector('.theme-icon-moon')!.classList.toggle('hidden', dark);
        const meta = document.querySelectorAll('meta[name="theme-color"]');
        meta.forEach((m) => m.setAttribute('content', dark ? '#0e1016' : '#fbfaf6'));
      };
      sync();
      btn.addEventListener('click', () => {
        const dark = root.classList.toggle('dark');
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
        sync();
        window.dispatchEvent(new CustomEvent('themechange'));
      });

      // Mobile menu
      const menuBtn = document.getElementById('menu-toggle')!;
      const menu = document.getElementById('mobile-nav')!;
      const setMenu = (open: boolean) => {
        menu.classList.toggle('hidden', !open);
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      menuBtn.addEventListener('click', () => setMenu(menu.classList.contains('hidden')));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !menu.classList.contains('hidden')) { setMenu(false); menuBtn.focus(); }
      });

      // Scroll reveal (content is visible without JS and with reduced motion)
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
